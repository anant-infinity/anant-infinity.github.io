---
import '../styles/global.css';
import { profile } from '../data/profile';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Soft deep-space surface — sitewide default; keep for Research call sites */
  variant?: 'default' | 'space';
}

const {
  title,
  description = title ? profile.intro : profile.seoDescription,
  ogImage = '/images/og-default.svg',
  // Accepted for Research call sites; space theme is always on.
  variant: _variant = 'space',
} = Astro.props;

const pageTitle = title ? `${title} · ${profile.shortName}` : profile.homeTitle;
const siteOrigin = Astro.site ?? new URL(profile.website);
const canonical = new URL(Astro.url.pathname, siteOrigin).href;
const ogAbs = new URL(ogImage, siteOrigin).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  honorificSuffix: 'Ph.D.',
  jobTitle: profile.title,
  url: profile.website,
  affiliation: {
    '@type': 'Organization',
    name: profile.affiliation,
    parentOrganization: {
      '@type': 'Organization',
      name: profile.university,
    },
  },
  sameAs: [
    profile.links.lasp,
    profile.links.scholar,
    profile.links.orcid,
    profile.links.github,
    profile.links.linkedin,
    profile.links.instagram,
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogAbs} />
    <meta property="og:site_name" content={profile.shortName} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogAbs} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
  </head>
  <body class:list={['min-h-screen flex flex-col', 'theme-space']}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-surface focus:px-3 focus:py-2 focus:shadow"
    >
      Skip to content
    </a>
    <SiteHeader />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
