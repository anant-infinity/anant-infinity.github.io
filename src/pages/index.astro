---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SolarMotif from '../components/SolarMotif.astro';
import { profile } from '../data/profile';
import { getFeaturedPublications, boldAuthorHtml, publicationYearLabel } from '../lib/publications';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection('news')).sort((a, b) => String(b.data.date).localeCompare(String(a.data.date)));
const featured = getFeaturedPublications(3);

const linkOrPlaceholder = (href: string, label: string, placeholderLabel: string) =>
  href
    ? { href, label, external: true, placeholder: false }
    : { href: `${base}/contact`, label: placeholderLabel, external: false, placeholder: true };

const social = [
  { href: profile.links.scholar, label: 'Google Scholar', external: true, placeholder: false },
  { href: profile.links.linkedin, label: 'LinkedIn', external: true, placeholder: false },
  linkOrPlaceholder(profile.links.orcid, 'ORCID', 'ORCID (placeholder)'),
  linkOrPlaceholder(profile.links.email ? `mailto:${profile.links.email}` : '', 'Email', 'Email (placeholder)'),
];
---

<BaseLayout>
  <section class="mx-auto grid max-w-[var(--max-content)] gap-10 px-5 py-12 md:grid-cols-2 md:items-center md:gap-14 md:px-8 md:py-16">
    <div class="fade-in">
      <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-accent uppercase">{profile.eyebrow}</p>
      <h1 class="font-heading text-4xl font-semibold tracking-tight text-ink md:text-5xl">{profile.name}</h1>
      <p class="mt-3 text-lg font-medium text-ink">{profile.title}</p>
      <p class="mt-1 text-muted">{profile.division} · {profile.affiliation}</p>
      <p class="mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg">{profile.intro}</p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a
          href={`${base}/research`}
          class="inline-flex items-center rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-white transition hover:brightness-95"
        >
          Explore Research
        </a>
        <a
          href={`${base}/publications`}
          class="inline-flex items-center rounded-md border border-border bg-surface px-4 py-2.5 text-sm font-medium text-ink transition hover:bg-border/40"
        >
          View Publications
        </a>
      </div>
      <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        {
          social.map((item) =>
            item.external ? (
              <a class="text-accent hover:underline" href={item.href} rel="noopener noreferrer" target="_blank">
                {item.label}
              </a>
            ) : (
              <a class="text-muted hover:text-ink" href={item.href}>
                {item.label}
              </a>
            ),
          )
        }
      </div>
    </div>
    <SolarMotif />
  </section>

  <section class="mx-auto max-w-[var(--max-content)] px-5 pb-14 md:px-8">
    <div class="mb-8 max-w-3xl fade-in fade-in-delay-1">
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-accent uppercase">Research</p>
      <h2 class="font-heading text-2xl font-semibold tracking-tight md:text-3xl">Themes & instruments</h2>
      <p class="mt-3 text-muted">
        Four editable research themes. Open each project page for overview, motivation, methods, and collaborators.
      </p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        research.map((project, index) => (
          <a
            href={`${base}/research/${project.id}`}
            class:list={[
              'group rounded-sm border border-border bg-surface/90 p-5 transition hover:border-accent/40 hover:shadow-sm',
              `fade-in fade-in-delay-${(index % 3) + 1}`,
            ]}
          >
            <div class="flex items-start justify-between gap-3">
              <h3 class="font-heading text-lg font-semibold text-ink group-hover:text-accent">{project.data.title}</h3>
              {project.data.placeholder && (
                <span class="shrink-0 text-[10px] font-semibold tracking-wide text-solar uppercase">Placeholder</span>
              )}
            </div>
            <p class="mt-2 text-sm leading-relaxed text-muted">{project.data.summary}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section class="border-y border-border bg-surface/70">
    <div class="mx-auto max-w-[var(--max-content)] px-5 py-14 md:px-8">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-accent uppercase">Publications</p>
          <h2 class="font-heading text-2xl font-semibold tracking-tight md:text-3xl">Featured work</h2>
        </div>
        <a href={`${base}/publications`} class="text-sm font-medium text-accent hover:underline">All publications</a>
      </div>
      <ul class="space-y-5">
        {
          featured.map((pub) => (
            <li class="border-b border-border pb-5 last:border-0 last:pb-0">
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-heading text-base font-semibold text-ink md:text-lg">{pub.title}</h3>
                {pub.placeholder && (
                  <span class="text-[10px] font-semibold tracking-wide text-solar uppercase">Placeholder</span>
                )}
              </div>
              <p class="mt-1 text-sm text-muted" set:html={boldAuthorHtml(pub.authors)} />
              <p class="mt-1 text-sm text-muted">
                {publicationYearLabel(pub.year)} · {pub.venue}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-[var(--max-content)] px-5 py-14 md:px-8">
    <div class="mb-8">
      <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-accent uppercase">News</p>
      <h2 class="font-heading text-2xl font-semibold tracking-tight md:text-3xl">Updates</h2>
    </div>
    <ol class="relative space-y-6 border-l border-border pl-6">
      {
        news.map((item) => (
          <li class="relative">
            <span class="absolute -left-[1.6rem] top-1.5 h-2.5 w-2.5 rounded-full bg-accent" />
            <p class="text-xs font-medium tracking-wide text-muted uppercase">{item.data.date}</p>
            <h3 class="mt-1 font-heading text-base font-semibold text-ink">
              {item.data.title}
              {item.data.placeholder && (
                <span class="ml-2 text-[10px] font-semibold tracking-wide text-solar uppercase">Placeholder</span>
              )}
            </h3>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
