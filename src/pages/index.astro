---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrbitalBackdrop from '../components/OrbitalBackdrop.astro';
import FeaturedResearchCard from '../components/FeaturedResearchCard.astro';
import { profile } from '../data/profile';
import { homeFeaturedResearch } from '../data/research-portfolio';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const baseTrim = base.replace(/\/$/, '');

const coverLinks = [
  { href: `${base}research/`, label: 'Explore Research', primary: true },
  { href: `${base}publications/`, label: 'View Publications', primary: false },
  { href: `${base}about/`, label: 'About', primary: false },
  { href: `${base}cv/`, label: 'CV', primary: false },
];

const featuredHref = (entry: (typeof homeFeaturedResearch)[number]) => {
  if (entry.href) return `${baseTrim}${entry.href}`;
  return `${base}research/#${entry.id}`;
};
---

<BaseLayout variant="space">
  <section class="relative overflow-hidden">
    <OrbitalBackdrop />
    <div
      class="relative mx-auto flex min-h-[calc(100svh-4.25rem)] max-w-[var(--max-content)] flex-col justify-center px-5 py-12 md:px-8 md:py-16"
    >
      <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
        <div class="fade-in">
          <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-solar uppercase">{profile.eyebrow}</p>
          <h1 class="font-heading text-4xl font-semibold tracking-tight text-ink md:text-5xl">{profile.name}</h1>
          <p class="mt-3 text-lg font-medium text-ink">{profile.title}</p>
          <p class="mt-1 text-muted">{profile.division} · {profile.affiliation}</p>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg">{profile.intro}</p>
          <nav class="mt-8 flex flex-wrap gap-3" aria-label="Cover">
            {
              coverLinks.map((link, index) => (
                <a
                  href={link.href}
                  class:list={[
                    'inline-flex items-center rounded-md px-4 py-2.5 text-sm font-medium transition',
                    `fade-in fade-in-delay-${Math.min(index + 1, 3)}`,
                    link.primary
                      ? 'bg-solar text-bg hover:brightness-105'
                      : 'border border-border bg-surface/60 text-ink hover:border-solar/50 hover:bg-surface',
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>
        <figure class="fade-in fade-in-delay-2">
          <div class="relative aspect-[4/3] overflow-hidden rounded-sm border border-border bg-surface">
            <picture>
              <source srcset={`${base}images/portrait.webp`} type="image/webp" />
              <img
                src={`${base}images/portrait.jpg`}
                alt={`Portrait of ${profile.name}`}
                class="h-full w-full object-cover object-center"
                width="1600"
                height="1200"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </div>
        </figure>
      </div>
    </div>
  </section>

  <section class="relative border-t border-border">
    <div class="mx-auto max-w-[var(--max-content)] px-5 py-14 md:px-8 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] text-solar uppercase">Research</p>
          <h2 class="mt-1 font-heading text-xl font-semibold text-ink md:text-2xl">
            Featured Research
          </h2>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0">
        {
          homeFeaturedResearch.map((entry) => (
            <FeaturedResearchCard
              title={entry.homeTitle ?? entry.title}
              role={entry.homeRole ?? entry.role}
              program={entry.homeProgram ?? entry.program}
              summary={entry.summary}
              href={featuredHref(entry)}
            />
          ))
        }
      </div>

      <p class="mt-12">
        <a href={`${base}research/`} class="text-sm font-medium text-solar hover:underline">
          View All Research →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
