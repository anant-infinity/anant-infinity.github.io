---
import BaseLayout from '../layouts/BaseLayout.astro';
import SolarMotif from '../components/SolarMotif.astro';
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const coverLinks = [
  { href: `${base}research/`, label: 'Explore Research', primary: true },
  { href: `${base}publications/`, label: 'View Publications', primary: false },
  { href: `${base}about/`, label: 'About', primary: false },
  { href: `${base}cv/`, label: 'CV', primary: false },
];
---

<BaseLayout>
  <section
    class="mx-auto flex min-h-[calc(100svh-4.25rem)] max-w-[var(--max-content)] flex-col justify-center px-5 py-12 md:px-8 md:py-16"
  >
    <div class="grid items-center gap-10 md:grid-cols-2 md:gap-14">
      <div class="fade-in">
        <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-accent uppercase">{profile.eyebrow}</p>
        <h1 class="font-heading text-4xl font-semibold tracking-tight text-ink md:text-5xl">{profile.name}</h1>
        <p class="mt-3 text-lg font-medium text-ink">{profile.title}</p>
        <p class="mt-1 text-muted">{profile.division} · {profile.affiliation}</p>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-muted md:text-lg">{profile.intro}</p>
        <nav class="mt-8 flex flex-wrap gap-3" aria-label="Cover">
          {
            coverLinks.map((link, index) => (
              <a
                href={link.href}
                class:list={[
                  'inline-flex items-center rounded-md px-4 py-2.5 text-sm font-medium transition',
                  `fade-in fade-in-delay-${Math.min(index + 1, 3)}`,
                  link.primary
                    ? 'bg-accent text-white hover:brightness-95'
                    : 'border border-border bg-surface text-ink hover:bg-border/40',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
      </div>
      <SolarMotif />
    </div>
  </section>
</BaseLayout>
