---
import BaseLayout from '../layouts/BaseLayout.astro';
import OrbitalBackdrop from '../components/OrbitalBackdrop.astro';
import HeroSpaceField from '../components/HeroSpaceField.astro';
import SoundingRocket from '../components/SoundingRocket.astro';
import FeaturedResearchCard from '../components/FeaturedResearchCard.astro';
import { profile } from '../data/profile';
import { homeFeaturedResearch } from '../data/research-portfolio';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const coverLinks = [
  { href: `${base}research/`, label: 'Explore Research', primary: true },
  { href: `${base}publications/`, label: 'View Publications', primary: false },
  { href: `${base}about/`, label: 'About', primary: false },
  { href: `${base}cv/`, label: 'CV', primary: false },
];

const featuredHref = (entry: (typeof homeFeaturedResearch)[number]) => {
  if (!entry.href) return undefined;
  return entry.href;
};
---

<BaseLayout variant="space">
  <section class="relative overflow-hidden">
    <HeroSpaceField />
    <SoundingRocket />
    <OrbitalBackdrop />
    <div
      class="relative z-[1] mx-auto flex min-h-[calc(100svh-4.25rem)] max-w-[var(--max-content)] flex-col justify-center px-5 py-12 md:px-8 md:py-16"
    >
      <div
        class="grid items-center gap-8 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,1.55fr)_minmax(0,0.95fr)] lg:gap-8"
      >
        <figure class="hero-portrait fade-in order-1 relative mx-auto w-full max-w-[14rem] sm:max-w-[16rem] lg:mx-0 lg:max-w-[13.5rem]">
          <div class="hero-portrait__media relative aspect-[3/4] overflow-hidden">
            <picture>
              <source srcset={`${base}images/portrait.webp`} type="image/webp" />
              <img
                src={`${base}images/portrait.jpg`}
                alt={`Portrait of ${profile.name}`}
                class="absolute inset-0 h-full w-[200%] max-w-none -translate-x-1/2 object-cover object-right"
                width="800"
                height="1200"
                decoding="async"
                fetchpriority="high"
              />
            </picture>
            <div class="hero-portrait__vignette" aria-hidden="true"></div>
          </div>
        </figure>

        <div class="fade-in order-2 text-center lg:text-left">
          <p class="mb-3 text-xs font-semibold tracking-[0.18em] text-solar uppercase">{profile.eyebrow}</p>
          <h1 class="font-heading text-4xl font-semibold tracking-tight text-ink md:text-5xl">{profile.name}</h1>
          <p class="mt-3 text-lg font-medium text-ink">{profile.title}</p>
          <p class="mt-1 text-muted">{profile.division} · {profile.affiliation}</p>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-muted md:mx-0 md:text-lg mx-auto">
            {profile.intro}
          </p>
          <nav
            class="hero-cover-nav mt-8 flex flex-wrap justify-center gap-2.5 lg:flex-nowrap lg:justify-start lg:gap-2.5"
            aria-label="Cover"
          >
            {
              coverLinks.map((link, index) => (
                <a
                  href={link.href}
                  class:list={[
                    'inline-flex shrink-0 items-center whitespace-nowrap rounded-md px-3.5 py-2.5 text-sm font-medium transition',
                    `fade-in fade-in-delay-${Math.min(index + 1, 3)}`,
                    link.primary
                      ? 'bg-solar text-bg hover:brightness-105'
                      : 'border border-border bg-surface/60 text-ink hover:border-solar/50 hover:bg-surface',
                  ]}
                >
                  {link.label}
                </a>
              ))
            }
          </nav>
        </div>

        <figure class="hero-sdo fade-in fade-in-delay-2 order-3 relative mx-auto w-full max-w-sm lg:mx-0 lg:max-w-none">
          <div class="hero-sdo__stage relative mx-auto aspect-square w-[88%] lg:w-[92%]">
            <div class="hero-sdo__orbit" aria-hidden="true">
              <div class="hero-sdo__orbit-ring"></div>
              <div class="hero-sdo__orbit-arm">
                <svg
                  class="hero-sdo__satellite"
                  viewBox="0 0 48 28"
                  width="52"
                  height="30"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <!-- Left solar panel -->
                  <rect x="1" y="9" width="12" height="10" rx="1" fill="currentColor" class="text-ink/50" />
                  <line x1="4" y1="9" x2="4" y2="19" stroke="currentColor" class="text-border" stroke-width="0.6" />
                  <line x1="7" y1="9" x2="7" y2="19" stroke="currentColor" class="text-border" stroke-width="0.6" />
                  <line x1="10" y1="9" x2="10" y2="19" stroke="currentColor" class="text-border" stroke-width="0.6" />
                  <!-- Right solar panel -->
                  <rect x="35" y="9" width="12" height="10" rx="1" fill="currentColor" class="text-ink/50" />
                  <line x1="38" y1="9" x2="38" y2="19" stroke="currentColor" class="text-border" stroke-width="0.6" />
                  <line x1="41" y1="9" x2="41" y2="19" stroke="currentColor" class="text-border" stroke-width="0.6" />
                  <line x1="44" y1="9" x2="44" y2="19" stroke="currentColor" class="text-border" stroke-width="0.6" />
                  <!-- Bus -->
                  <rect x="16" y="8" width="16" height="12" rx="2" fill="currentColor" class="text-ink/75" />
                  <rect x="20" y="11" width="8" height="3.5" rx="0.8" fill="currentColor" class="text-solar/70" />
                  <!-- Antenna -->
                  <line x1="24" y1="8" x2="24" y2="2" stroke="currentColor" class="text-ink/60" stroke-width="1" />
                  <circle cx="24" cy="2" r="1.4" fill="currentColor" class="text-solar/75" />
                </svg>
              </div>
            </div>

            <div class="hero-sdo__media absolute inset-[9%] overflow-hidden">
              <img
                class="hero-sdo__gif h-full w-full object-cover object-center"
                src={`${base}images/NASA-SDO-Solar-Flare-March-2022.gif`}
                alt="NASA Solar Dynamics Observatory AIA animation of an X1.3-class solar flare on March 30, 2022, blending 171 and 131 angstrom extreme ultraviolet light"
                width="718"
                height="685"
                decoding="async"
                loading="lazy"
              />
              <div class="hero-sdo__vignette" aria-hidden="true"></div>
            </div>
          </div>
          <figcaption class="hero-sdo__credit mt-3 text-center text-xs tracking-wide text-muted lg:text-left">
            Credit: NASA SDO / AIA
          </figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="relative border-t border-border">
    <div class="mx-auto max-w-[var(--max-content)] px-5 py-14 md:px-8 md:py-16">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="text-xs font-semibold tracking-[0.18em] text-solar uppercase">Research</p>
          <h2 class="mt-1 font-heading text-xl font-semibold text-ink md:text-2xl">
            Featured Research
          </h2>
        </div>
      </div>

      <div class="mt-10 grid grid-cols-1 gap-10 md:grid-cols-3 md:gap-0">
        {
          homeFeaturedResearch.map((entry) => (
            <FeaturedResearchCard
              title={entry.homeTitle ?? entry.title}
              role={entry.homeRole ?? entry.role}
              program={entry.homeProgram ?? entry.program}
              summary={entry.summary}
              href={featuredHref(entry)}
            />
          ))
        }
      </div>

      <p class="mt-12">
        <a href={`${base}research/`} class="text-sm font-medium text-solar hover:underline">
          View All Research →
        </a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* Soft feather into deep-space bg — portrait */
  .hero-portrait__media {
    background: transparent;
    -webkit-mask-image: radial-gradient(
      ellipse 88% 86% at 48% 42%,
      #000 48%,
      rgba(0, 0, 0, 0.82) 68%,
      rgba(0, 0, 0, 0.35) 84%,
      transparent 100%
    );
    mask-image: radial-gradient(
      ellipse 88% 86% at 48% 42%,
      #000 48%,
      rgba(0, 0, 0, 0.82) 68%,
      rgba(0, 0, 0, 0.35) 84%,
      transparent 100%
    );
  }

  .hero-portrait__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      ellipse 78% 80% at 48% 40%,
      transparent 42%,
      color-mix(in oklab, var(--color-bg) 55%, transparent) 78%,
      var(--color-bg) 100%
    );
  }

  .hero-sdo__media {
    background: transparent;
    border-radius: 50%;
    -webkit-mask-image: radial-gradient(
      circle at 50% 50%,
      #000 42%,
      rgba(0, 0, 0, 0.88) 58%,
      rgba(0, 0, 0, 0.4) 72%,
      transparent 86%
    );
    mask-image: radial-gradient(
      circle at 50% 50%,
      #000 42%,
      rgba(0, 0, 0, 0.88) 58%,
      rgba(0, 0, 0, 0.4) 72%,
      transparent 86%
    );
  }

  /* Soften the GIF’s hard black field into the page */
  .hero-sdo__gif {
    transform: scale(1.04);
    filter: blur(0.35px) brightness(1.04) contrast(1.06);
  }

  .hero-sdo__vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 50%,
      transparent 38%,
      color-mix(in oklab, var(--color-bg) 35%, transparent) 62%,
      color-mix(in oklab, var(--color-bg) 78%, transparent) 78%,
      var(--color-bg) 94%
    );
    box-shadow: inset 0 0 36px 18px color-mix(in oklab, var(--color-bg) 70%, transparent);
  }

  .hero-sdo__credit {
    position: relative;
    z-index: 2;
  }

  /* Satellite orbits the SDO media, not the full hero */
  .hero-sdo__orbit {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    opacity: 0.85;
  }

  .hero-sdo__orbit-ring {
    position: absolute;
    inset: 2%;
    border: 1px solid color-mix(in oklab, var(--color-border) 50%, transparent);
    border-radius: 50%;
    opacity: 0.4;
  }

  .hero-sdo__orbit-arm {
    position: absolute;
    inset: 0;
    animation: hero-sdo-satellite-orbit 32s linear infinite;
  }

  .hero-sdo__satellite {
    position: absolute;
    top: 0;
    left: 50%;
    width: clamp(2.15rem, 3.8vw, 3.15rem);
    height: auto;
    margin-left: calc(clamp(2.15rem, 3.8vw, 3.15rem) / -2);
    color: var(--color-ink);
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-solar) 28%, transparent));
    animation: hero-sdo-satellite-level 32s linear infinite;
  }

  @keyframes hero-sdo-satellite-orbit {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes hero-sdo-satellite-level {
    from {
      transform: rotate(0deg);
    }
    to {
      transform: rotate(-360deg);
    }
  }

  @media (max-width: 1023px) {
    .hero-sdo__satellite {
      width: clamp(1.85rem, 6vw, 2.5rem);
      margin-left: calc(clamp(1.85rem, 6vw, 2.5rem) / -2);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-sdo__orbit-arm,
    .hero-sdo__satellite {
      animation: none;
    }

    .hero-sdo__orbit-arm {
      transform: rotate(-40deg);
    }

    .hero-sdo__satellite {
      transform: rotate(40deg);
      filter: none;
      opacity: 0.7;
    }

    .hero-sdo__gif {
      filter: brightness(1.04) contrast(1.06);
    }
  }
</style>
