---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { profile } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Contact" description={`Contact ${profile.shortName}.`} variant="space">
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="Contact"
      title="Get in touch"
      description="Reach out through these profiles and affiliations."
    />

    <ul class="mt-2 grid max-w-xl grid-cols-3 gap-3 sm:gap-4">
      {
        profile.contactLogos.map((item) => (
          <li>
            <a
              class="group flex aspect-square items-center justify-center rounded-sm border border-border bg-surface/60 p-3 transition hover:border-solar/60 hover:bg-bg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-solar sm:p-4"
              href={item.href}
              rel="noopener noreferrer"
              target="_blank"
              aria-label={item.label}
              title={item.label}
            >
              <img
                src={`${base}${item.logo}`}
                alt=""
                width="48"
                height="48"
                class="h-10 w-10 object-contain transition group-hover:scale-105 sm:h-12 sm:w-12"
                loading="lazy"
                decoding="async"
              />
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
