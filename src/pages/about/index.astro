---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { profile } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const galleryDir = path.join(process.cwd(), 'public/images/about-gallery');
const imageExts = new Set(['.jpg', '.jpeg', '.png', '.webp', '.gif']);

type GalleryItem = { src: string; alt: string; caption?: string };

function loadCaptions(dir: string): Record<string, string> {
  const captionsPath = path.join(dir, 'captions.json');
  if (!fs.existsSync(captionsPath)) return {};
  try {
    const raw = JSON.parse(fs.readFileSync(captionsPath, 'utf8')) as unknown;
    if (!raw || typeof raw !== 'object' || Array.isArray(raw)) return {};
    const out: Record<string, string> = {};
    for (const [key, value] of Object.entries(raw as Record<string, unknown>)) {
      if (typeof value === 'string' && value.trim()) out[key] = value.trim();
    }
    return out;
  } catch {
    return {};
  }
}

function loadGallery(dir: string): GalleryItem[] {
  if (!fs.existsSync(dir)) return [];
  const captions = loadCaptions(dir);
  return fs
    .readdirSync(dir)
    .filter((name) => imageExts.has(path.extname(name).toLowerCase()))
    .sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }))
    .map((name) => {
      const caption = captions[name];
      const fallback = name.replace(/\.[^.]+$/, '').replace(/[-_]+/g, ' ');
      return {
        src: `${base}/images/about-gallery/${encodeURIComponent(name)}`,
        alt: caption ?? fallback,
        caption,
      };
    });
}

const gallery = loadGallery(galleryDir);
---

<BaseLayout title="About" description={`About ${profile.shortName}.`} variant="space">
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="About"
      title={profile.shortName}
      description={`${profile.title} · ${profile.affiliation}`}
    />

    <div class="grid gap-10 md:grid-cols-[220px_minmax(0,1fr)]">
      <figure>
        <div class="aspect-[4/5] overflow-hidden rounded-sm border border-border bg-surface">
          <picture>
            <source srcset={`${base}/images/portrait.webp`} type="image/webp" />
            <img
              src={`${base}/images/portrait.jpg`}
              alt={`Portrait of ${profile.shortName}`}
              class="h-full w-full object-cover object-center"
              loading="eager"
              width="1600"
              height="1200"
            />
          </picture>
        </div>
      </figure>

      <div class="space-y-4 text-base leading-relaxed text-muted">
        {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
        <p class="text-sm">
          LASP people page:
          <a class="text-solar hover:underline" href={profile.links.lasp} rel="noopener noreferrer" target="_blank">
            lasp.colorado.edu
          </a>
        </p>
      </div>
    </div>

    <div class="mt-14">
      <h2 class="font-heading mb-4 text-lg font-semibold text-ink">Photos</h2>

      {
        gallery.length > 0 ? (
          <div
            class="about-gallery -mx-5 flex gap-3 overflow-x-auto px-5 pb-2 md:-mx-0 md:px-0"
            role="list"
            aria-label="Personal photo gallery"
          >
            {gallery.map((item) => (
              <figure
                class="about-gallery__item m-0 shrink-0 overflow-hidden rounded-sm border border-border bg-surface"
                role="listitem"
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  class="h-44 w-auto max-w-none object-cover object-center sm:h-52"
                  loading="lazy"
                  decoding="async"
                />
                {item.caption && (
                  <figcaption class="px-2.5 py-1.5 text-xs text-muted">{item.caption}</figcaption>
                )}
              </figure>
            ))}
          </div>
        ) : (
          <p class="rounded-sm border border-dashed border-border bg-surface/40 px-4 py-8 text-center text-sm text-muted">
            Add photos to <code class="text-solar">public/images/about-gallery/</code>
          </p>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .about-gallery {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in oklab, var(--color-solar) 45%, transparent) transparent;
  }

  .about-gallery__item img {
    display: block;
  }
</style>
