---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { profile } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const leftPhotos = [
  {
    src: `${base}/images/about-gallery/anant_img2.png`,
    alt: 'Anant inside the lab',
    caption: 'Anant inside the lab',
  },
  {
    src: `${base}/images/about-gallery/anant_img1.png`,
    alt: 'Anant outside the lab',
    caption: 'Anant outside the lab',
  },
] as const;

const mapPhoto = {
  src: `${base}/images/about-gallery/Anant_Map.png`,
  alt: "Places I've lived, studied, and researched",
  caption: "Places I've lived, studied, and researched",
} as const;
---

<BaseLayout title="About" description={`About ${profile.shortName}.`} variant="space">
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="About"
      title={profile.shortName}
      description={`${profile.title} · ${profile.affiliation}`}
    />

    <div class="about-layout">
      <aside class="about-layout__photos fade-in" aria-label="Photos of Anant">
        {
          leftPhotos.map((photo) => (
            <figure class="about-figure">
              <div class="about-figure__frame">
                <img
                  src={photo.src}
                  alt={photo.alt}
                  class="about-figure__img"
                  loading="eager"
                  decoding="async"
                />
              </div>
              <figcaption class="about-figure__caption">{photo.caption}</figcaption>
            </figure>
          ))
        }
      </aside>

      <div class="about-layout__bio fade-in fade-in-delay-1">
        <div class="space-y-4 text-base leading-relaxed text-muted">
          {profile.bio.map((paragraph) => <p>{paragraph}</p>)}
          <p class="text-sm">
            LASP people page:
            <a class="text-solar hover:underline" href={profile.links.lasp} rel="noopener noreferrer" target="_blank">
              lasp.colorado.edu
            </a>
          </p>
        </div>
      </div>

      <aside class="about-layout__map fade-in fade-in-delay-2" aria-label="Map of places">
        <figure class="about-figure about-figure--map">
          <div class="about-figure__frame about-figure__frame--map">
            <img
              src={mapPhoto.src}
              alt={mapPhoto.alt}
              class="about-figure__img about-figure__img--map"
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption class="about-figure__caption">{mapPhoto.caption}</figcaption>
        </figure>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .about-layout {
    display: grid;
    gap: 2rem;
  }

  @media (min-width: 900px) {
    .about-layout {
      /* Narrow photos · bio · prominent map */
      grid-template-columns: minmax(0, 11.5rem) minmax(0, 1fr) minmax(0, 1.55fr);
      gap: 1.5rem 1.35rem;
      align-items: start;
    }
  }

  .about-layout__photos {
    display: grid;
    gap: 0.85rem;
  }

  .about-figure {
    margin: 0;
  }

  .about-figure__frame {
    overflow: hidden;
    border-radius: 0.125rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .about-figure__frame--map {
    background: color-mix(in oklab, var(--color-surface) 85%, white 4%);
  }

  .about-figure__img {
    display: block;
    width: 100%;
    height: auto;
    /* Landscape-leaning crop so stacked photos stay short */
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: center;
  }

  .about-figure__img--map {
    aspect-ratio: auto;
    object-fit: contain;
    object-position: center;
    padding: 0.65rem;
    background: color-mix(in oklab, var(--color-surface) 70%, #0a1424);
  }

  .about-figure__caption {
    margin-top: 0.45rem;
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--color-muted);
  }

  /* Mobile: keep photos readable but not oversized */
  @media (max-width: 899px) {
    .about-layout__photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
    }

    .about-figure__img {
      aspect-ratio: 4 / 3;
    }

    .about-layout__map .about-figure__img--map {
      width: 100%;
      min-height: 14rem;
    }
  }

  @media (min-width: 900px) {
    .about-layout__map .about-figure__img--map {
      min-height: 22rem;
      padding: 0.85rem;
    }

    .about-figure--map .about-figure__caption {
      font-size: 0.875rem;
    }
  }
</style>
