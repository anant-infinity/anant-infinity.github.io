---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const research = await getCollection('research');
const byId = Object.fromEntries(research.map((project) => [project.id, project]));

const instrumentation = [byId['seushi']].filter(Boolean);
const dataAnalysis = [byId['hope']].filter(Boolean);
const other = research
  .filter((project) => project.id !== 'seushi' && project.id !== 'hope')
  .sort((a, b) => a.data.order - b.data.order);

function projectCard(project: (typeof research)[number]) {
  return {
    href: `${base}/research/${project.id}`,
    title: project.data.title,
    summary: project.data.summary,
    placeholder: project.data.placeholder,
  };
}
---

<BaseLayout title="Research" description="Current space instrumentation and data analysis projects.">
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="Research"
      title="Current projects"
      description="Overview of active space instrumentation and solar flare data-analysis work. Project pages follow a shared template with content in Markdown under `src/content/research/`."
    />

    <div class="mt-10 grid gap-10 md:grid-cols-2 md:gap-12">
      <div>
        <h2 class="font-heading text-xl font-semibold text-ink md:text-2xl">
          Current Space Instrumentation projects
        </h2>
        <div class="mt-5 divide-y divide-border border-y border-border">
          {
            instrumentation.map((project) => {
              const card = projectCard(project);
              return (
                <a href={card.href} class="group block py-5 transition hover:bg-surface/80">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="font-heading text-lg font-semibold text-ink group-hover:text-accent">
                        {card.title}
                      </h3>
                      <p class="mt-2 text-muted">{card.summary}</p>
                    </div>
                    <span class="mt-1 text-accent" aria-hidden="true">
                      →
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>

      <div>
        <h2 class="font-heading text-xl font-semibold text-ink md:text-2xl">
          Current Data Analysis Projects
        </h2>
        <div class="mt-5 divide-y divide-border border-y border-border">
          {
            dataAnalysis.map((project) => {
              const card = projectCard(project);
              return (
                <a href={card.href} class="group block py-5 transition hover:bg-surface/80">
                  <div class="flex items-start justify-between gap-4">
                    <div>
                      <h3 class="font-heading text-lg font-semibold text-ink group-hover:text-accent">
                        {card.title}
                      </h3>
                      <p class="mt-2 text-muted">{card.summary}</p>
                    </div>
                    <span class="mt-1 text-accent" aria-hidden="true">
                      →
                    </span>
                  </div>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>

    {
      other.length > 0 && (
        <div class="mt-14">
          <h2 class="font-heading text-xl font-semibold text-ink">Related themes</h2>
          <div class="mt-5 divide-y divide-border border-y border-border">
            {other.map((project) => {
              const card = projectCard(project);
              return (
                <a
                  href={card.href}
                  class="group flex items-start justify-between gap-4 py-5 transition hover:bg-surface/80"
                >
                  <div class="max-w-3xl">
                    <h3 class="font-heading text-lg font-semibold text-ink group-hover:text-accent">
                      {card.title}
                    </h3>
                    <p class="mt-2 text-muted">{card.summary}</p>
                    {card.placeholder && (
                      <p class="mt-3 text-[10px] font-semibold tracking-wide text-solar uppercase">
                        Editable placeholder
                      </p>
                    )}
                  </div>
                  <span class="mt-1 text-accent" aria-hidden="true">
                    →
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
