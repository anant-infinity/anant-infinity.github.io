---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import PortfolioCard from '../../components/PortfolioCard.astro';
import OrbitalBackdrop from '../../components/OrbitalBackdrop.astro';
import { currentResearch, pastResearch } from '../../data/research-portfolio';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const withBase = (href?: string) => {
  if (!href) return undefined;
  return href.startsWith('http') ? href : `${base}${href}`;
};

const intro =
  'My research focuses on solar eruptive events, space-based X-ray instrumentation, and the development of techniques for improving space-weather forecasting and early warning. I contribute to NASA-funded research programs and space missions, with a particular emphasis on developing scientific instruments and translating solar observations into actionable space-weather information.';
---

<BaseLayout
  title="Research"
  description="Funded programs and missions in solar eruptive events, X-ray instrumentation, and space-weather forecasting."
  variant="space"
>
  <section class="relative overflow-hidden">
    <OrbitalBackdrop />
    <div class="relative mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
      <SectionHeading eyebrow="Research" title="Research" description={intro} />

      <div class="mt-14">
        <p class="text-xs font-semibold tracking-[0.18em] text-solar uppercase">Current</p>
        <h2 class="mt-1 font-heading text-xl font-semibold text-ink md:text-2xl">
          Current Research
        </h2>
        <div class="mt-8">
          {
            currentResearch.map((entry) => (
              <PortfolioCard
                id={entry.id}
                title={entry.title}
                role={entry.role}
                program={entry.program}
                years={entry.years}
                summary={entry.summary}
                href={withBase(entry.href)}
                amount={entry.amount}
              />
            ))
          }
        </div>
      </div>

      <div class="mt-20">
        <p class="text-xs font-semibold tracking-[0.18em] text-solar uppercase">Past</p>
        <h2 class="mt-1 font-heading text-xl font-semibold text-ink md:text-2xl">
          Past Research & Missions
        </h2>
        <div class="mt-8">
          {
            pastResearch.map((entry) => (
              <PortfolioCard
                id={entry.id}
                title={entry.title}
                role={entry.role}
                program={entry.program}
                years={entry.years}
                summary={entry.summary}
                href={withBase(entry.href)}
                amount={entry.amount}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
