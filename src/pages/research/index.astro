---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const research = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Research" description="Research themes and instrument projects.">
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="Research"
      title="Themes & projects"
      description="Each project page uses a shared template: Overview, Motivation, Methods, Results/Objectives, Publications, and Collaborators. Content lives in Markdown under `src/content/research/`."
    />
    <div class="divide-y divide-border border-y border-border">
      {
        research.map((project) => (
          <a
            href={`${base}/research/${project.id}`}
            class="group flex items-start justify-between gap-4 py-6 transition hover:bg-surface/80"
          >
            <div class="max-w-3xl">
              <h2 class="font-heading text-xl font-semibold text-ink group-hover:text-accent">{project.data.title}</h2>
              <p class="mt-2 text-muted">{project.data.summary}</p>
              {project.data.placeholder && (
                <p class="mt-3 text-[10px] font-semibold tracking-wide text-solar uppercase">Editable placeholder</p>
              )}
            </div>
            <span class="mt-1 text-accent" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
