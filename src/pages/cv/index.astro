---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { profile } from '../../data/profile';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cvHref = `${base}${profile.cv.path}`;
---

<BaseLayout title="CV" description={`Curriculum vitae for ${profile.shortName}.`}>
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="Curriculum vitae"
      title="CV"
      description={`Last updated: ${profile.cv.lastUpdated}.`}
    />

    {
      profile.cv.available ? (
        <div class="space-y-6">
          <a
            href={cvHref}
            class="inline-flex rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-white hover:brightness-95"
            download
          >
            Download CV (PDF)
          </a>
          <iframe title="CV PDF" src={cvHref} class="h-[80vh] w-full rounded-sm border border-border bg-surface" />
        </div>
      ) : (
        <div class="max-w-2xl rounded-sm border border-dashed border-border bg-surface/80 p-8">
          <p class="font-heading text-lg font-semibold text-ink">CV PDF not uploaded yet</p>
          <p class="mt-3 text-muted">
            This page is intentionally a placeholder. Add
            <code class="mx-1 rounded bg-border/60 px-1.5 py-0.5 text-sm">public/cv/anant-telikicherla-cv.pdf</code>
            and flip
            <code class="mx-1 rounded bg-border/60 px-1.5 py-0.5 text-sm">cv.available</code>
            to
            <code class="mx-1 rounded bg-border/60 px-1.5 py-0.5 text-sm">true</code>
            in profile data.
          </p>
        </div>
      )
    }
  </section>
</BaseLayout>
