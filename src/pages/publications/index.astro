---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { profile } from '../../data/profile';
import {
  publications,
  boldAuthorHtml,
  publicationYearLabel,
  uniqueTypes,
  uniqueYears,
  publicationsByYear,
  doiUrl,
  arxivUrl,
} from '../../lib/publications';

const types = uniqueTypes();
const years = uniqueYears();
const grouped = publicationsByYear();
---

<BaseLayout title="Publications" description="Papers, preprints, and related scholarly work." variant="space">
  <section class="mx-auto max-w-[var(--max-content)] px-5 py-12 md:px-8 md:py-16">
    <SectionHeading
      eyebrow="Publications"
      title="Papers & proceedings"
      description="List curated from the CV and cross-checked with Google Scholar / Crossref for DOIs and links. Matching author names are bolded automatically."
    />
    <p class="mb-8 text-sm">
      <a class="text-solar hover:underline" href={profile.links.scholar} rel="noopener noreferrer" target="_blank">
        Google Scholar
      </a>
      {
        profile.links.orcid && (
          <>
            {' · '}
            <a class="text-solar hover:underline" href={profile.links.orcid} rel="noopener noreferrer" target="_blank">
              ORCID
            </a>
          </>
        )
      }
    </p>

    <div class="mb-8 flex flex-wrap items-end gap-3" data-pub-filters>
      <label class="flex min-w-[14rem] flex-1 flex-col gap-1 text-xs font-medium text-muted">
        Search
        <input
          type="search"
          placeholder="Title, author, venue..."
          data-pub-search
          class="rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink outline-none focus:border-solar"
        />
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-muted">
        Type
        <select data-pub-type class="rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink">
          <option value="all">All types</option>
          {types.map((type) => <option value={type}>{type}</option>)}
        </select>
      </label>
      <label class="flex flex-col gap-1 text-xs font-medium text-muted">
        Year
        <select data-pub-year class="rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink">
          <option value="all">All years</option>
          {
            years.map((year) => (
              <option value={year == null ? 'tbd' : String(year)}>
                {year == null ? 'TBD' : year}
              </option>
            ))
          }
        </select>
      </label>
      <p class="pb-2 text-sm text-muted"><span data-pub-count>{publications.length}</span> shown</p>
    </div>

    <div class="space-y-10" data-pub-list>
      {
        grouped.map(({ year, items }) => (
          <section data-pub-year-group data-year={year == null ? 'tbd' : String(year)}>
            <h2 class="mb-4 font-heading text-lg font-semibold text-ink">
              {publicationYearLabel(year)}
            </h2>
            <ul class="space-y-5">
              {items.map((pub) => {
                const doiHref = doiUrl(pub.doi);
                const arxivHref = arxivUrl(pub.arxiv);
                return (
                  <li
                    class="border-b border-border pb-5"
                    data-pub-item
                    data-title={pub.title}
                    data-authors={pub.authors.join(' ')}
                    data-venue={pub.venue}
                    data-type={pub.type}
                    data-year={pub.year == null ? 'tbd' : String(pub.year)}
                  >
                    <h3 class="font-heading text-base font-semibold text-ink md:text-lg">{pub.title}</h3>
                    <p class="mt-1 text-sm text-muted" set:html={boldAuthorHtml(pub.authors)} />
                    <p class="mt-1 text-sm text-muted">
                      {publicationYearLabel(pub.year)} · {pub.venue} · {pub.type}
                    </p>
                    <p class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-sm">
                      {doiHref && (
                        <a class="text-solar hover:underline" href={doiHref} rel="noopener noreferrer" target="_blank">
                          DOI
                        </a>
                      )}
                      {pub.pdf && (
                        <a class="text-solar hover:underline" href={pub.pdf} rel="noopener noreferrer" target="_blank">
                          PDF
                        </a>
                      )}
                      {arxivHref && (
                        <a class="text-solar hover:underline" href={arxivHref} rel="noopener noreferrer" target="_blank">
                          arXiv
                        </a>
                      )}
                      {pub.url && !doiHref && (
                        <a class="text-solar hover:underline" href={pub.url} rel="noopener noreferrer" target="_blank">
                          Link
                        </a>
                      )}
                      {pub.url && doiHref && pub.url !== doiHref && !pub.pdf && (
                        <a class="text-solar hover:underline" href={pub.url} rel="noopener noreferrer" target="_blank">
                          Publisher
                        </a>
                      )}
                    </p>
                  </li>
                );
              })}
            </ul>
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<script>
  const search = document.querySelector('[data-pub-search]') as HTMLInputElement | null;
  const type = document.querySelector('[data-pub-type]') as HTMLSelectElement | null;
  const year = document.querySelector('[data-pub-year]') as HTMLSelectElement | null;
  const count = document.querySelector('[data-pub-count]');
  const items = [...document.querySelectorAll('[data-pub-item]')] as HTMLElement[];
  const groups = [...document.querySelectorAll('[data-pub-year-group]')] as HTMLElement[];

  const apply = () => {
    const q = (search?.value || '').trim().toLowerCase();
    const typeValue = type?.value || 'all';
    const yearValue = year?.value || 'all';
    let visible = 0;
    for (const item of items) {
      const hay = `${item.dataset.title} ${item.dataset.authors} ${item.dataset.venue}`.toLowerCase();
      const matchQ = !q || hay.includes(q);
      const matchType = typeValue === 'all' || item.dataset.type === typeValue;
      const matchYear = yearValue === 'all' || item.dataset.year === yearValue;
      const show = matchQ && matchType && matchYear;
      item.hidden = !show;
      if (show) visible += 1;
    }
    for (const group of groups) {
      const visibleInGroup = [...group.querySelectorAll('[data-pub-item]')].some(
        (el) => !(el as HTMLElement).hidden,
      );
      group.hidden = !visibleInGroup;
    }
    if (count) count.textContent = String(visible);
  };

  search?.addEventListener('input', apply);
  type?.addEventListener('change', apply);
  year?.addEventListener('change', apply);
</script>
