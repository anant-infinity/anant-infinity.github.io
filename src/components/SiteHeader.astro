---
import { profile } from '../data/profile';

const base = import.meta.env.BASE_URL;
const normalize = (path: string) => {
  const withBase = path === '/' ? base : `${base.replace(/\/$/, '')}${path}`;
  return withBase.endsWith('/') && withBase !== '/' ? withBase.slice(0, -1) : withBase;
};

const current = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/', label: 'Home' },
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/about', label: 'About' },
  { href: '/cv', label: 'CV' },
  { href: '/contact', label: 'Contact' },
];

const isActive = (href: string) => {
  const target = normalize(href).replace(/\/$/, '') || '/';
  const here = current.replace(/\/$/, '') || '/';
  if (href === '/') return here === target || here === normalize('/').replace(/\/$/, '');
  return here === target || here.startsWith(`${target}/`);
};
---

<header class="sticky top-0 z-40 border-b border-border/80 bg-bg/90 backdrop-blur">
  <div class="mx-auto flex max-w-[var(--max-content)] items-center justify-between gap-4 px-5 py-3 md:px-8">
    <a href={normalize('/')} class="font-heading text-sm font-semibold tracking-tight text-ink md:text-base">
      {profile.nameWithDegree}
    </a>
    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={normalize(link.href)}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              isActive(link.href)
                ? 'bg-border/70 font-medium text-ink'
                : 'text-muted hover:bg-border/40 hover:text-ink',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="inline-flex items-center justify-center rounded-md border border-border bg-surface px-3 py-2 text-sm text-ink md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      Menu
    </button>
  </div>
  <nav id="mobile-nav" class="hidden border-t border-border bg-surface md:hidden" aria-label="Mobile">
    <div class="mx-auto flex max-w-[var(--max-content)] flex-col gap-1 px-5 py-3">
      {
        links.map((link) => (
          <a
            href={normalize(link.href)}
            class:list={[
              'rounded-md px-3 py-2 text-sm',
              isActive(link.href) ? 'bg-border/70 font-medium text-ink' : 'text-muted',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-nav-toggle]');
  const panel = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const open = panel?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
