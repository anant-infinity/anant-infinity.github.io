---
/**
 * Minimal sounding-rocket silhouette for the homepage portrait.
 * Loops a gentle launch along the frame edge; static when reduced motion.
 */
---

<div class="sounding-rocket" aria-hidden="true">
  <div class="sounding-rocket__track">
    <svg
      class="sounding-rocket__craft"
      viewBox="0 0 40 120"
      width="28"
      height="84"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Nose cone -->
      <path d="M20 4 L26 28 H14 Z" fill="currentColor" class="text-ink/85" />
      <!-- Body -->
      <rect x="14" y="28" width="12" height="52" rx="1.5" fill="currentColor" class="text-ink/70" />
      <!-- Window / band -->
      <rect x="16.5" y="38" width="7" height="4" rx="1" fill="currentColor" class="text-solar/80" />
      <rect x="14" y="52" width="12" height="1.5" fill="currentColor" class="text-border" />
      <!-- Fins -->
      <path d="M14 68 L6 88 L14 80 Z" fill="currentColor" class="text-ink/75" />
      <path d="M26 68 L34 88 L26 80 Z" fill="currentColor" class="text-ink/75" />
      <!-- Exhaust plume -->
      <g class="sounding-rocket__plume">
        <path
          d="M17 82 C16 92 14 100 20 112 C26 100 24 92 23 82 Z"
          fill="currentColor"
          class="text-solar/55"
        />
        <path
          d="M18.5 82 C18 90 17 96 20 104 C23 96 22 90 21.5 82 Z"
          fill="currentColor"
          class="text-solar/85"
        />
      </g>
    </svg>
  </div>
</div>

<style>
  .sounding-rocket {
    position: absolute;
    /* Left of the portrait frame so the launch path clears the face crop */
    inset: -6% auto -4% -10%;
    width: 22%;
    min-width: 2.75rem;
    max-width: 3.75rem;
    pointer-events: none;
    z-index: 2;
    color: var(--color-ink);
  }

  .sounding-rocket__track {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: center;
  }

  .sounding-rocket__craft {
    position: absolute;
    bottom: 4%;
    transform-origin: center bottom;
    animation: sounding-rocket-launch 8.5s cubic-bezier(0.33, 0.05, 0.25, 1) infinite;
    filter: drop-shadow(0 0 6px color-mix(in oklab, var(--color-solar) 35%, transparent));
  }

  .sounding-rocket__plume {
    animation: sounding-rocket-plume 0.55s ease-in-out infinite alternate;
    transform-origin: center top;
  }

  @keyframes sounding-rocket-launch {
    0% {
      opacity: 0;
      transform: translate3d(0, 8%, 0) scale(0.92);
    }
    8% {
      opacity: 0.9;
      transform: translate3d(2%, 0%, 0) scale(1);
    }
    55% {
      opacity: 0.95;
      transform: translate3d(-4%, -78%, 0) scale(1);
    }
    78% {
      opacity: 0.55;
      transform: translate3d(-8%, -108%, 0) scale(0.96);
    }
    92%,
    100% {
      opacity: 0;
      transform: translate3d(-10%, -120%, 0) scale(0.9);
    }
  }

  @keyframes sounding-rocket-plume {
    from {
      opacity: 0.65;
      transform: scaleY(0.88);
    }
    to {
      opacity: 1;
      transform: scaleY(1.08);
    }
  }

  @media (max-width: 639px) {
    .sounding-rocket {
      inset: -4% auto -2% -8%;
      width: 18%;
      min-width: 2.25rem;
      opacity: 0.85;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sounding-rocket__craft {
      animation: none;
      opacity: 0.55;
      bottom: 18%;
      transform: none;
      filter: none;
    }

    .sounding-rocket__plume {
      animation: none;
      opacity: 0.5;
    }
  }
</style>
