---
/**
 * Larger sounding-rocket silhouette for the homepage hero background.
 * Gently crosses the full hero width behind content; static when reduced motion.
 */
---

<div class="sounding-rocket" aria-hidden="true">
  <div class="sounding-rocket__flight">
    <svg
      class="sounding-rocket__craft"
      viewBox="0 0 40 120"
      width="56"
      height="168"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
    >
      <!-- Nose cone -->
      <path d="M20 4 L27 30 H13 Z" fill="currentColor" class="text-ink/80" />
      <!-- Body -->
      <rect x="13" y="30" width="14" height="54" rx="1.75" fill="currentColor" class="text-ink/65" />
      <!-- Window / band -->
      <rect x="16" y="40" width="8" height="4.5" rx="1.25" fill="currentColor" class="text-solar/75" />
      <rect x="13" y="55" width="14" height="1.75" fill="currentColor" class="text-border" />
      <!-- Fins -->
      <path d="M13 70 L4 92 L13 83 Z" fill="currentColor" class="text-ink/70" />
      <path d="M27 70 L36 92 L27 83 Z" fill="currentColor" class="text-ink/70" />
      <!-- Exhaust plume -->
      <g class="sounding-rocket__plume">
        <path
          d="M16 86 C15 98 12 108 20 120 C28 108 25 98 24 86 Z"
          fill="currentColor"
          class="text-solar/50"
        />
        <path
          d="M18 86 C17.5 96 16.5 104 20 112 C23.5 104 22.5 96 22 86 Z"
          fill="currentColor"
          class="text-solar/80"
        />
      </g>
    </svg>
  </div>
</div>

<style>
  .sounding-rocket {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
    color: var(--color-ink);
  }

  .sounding-rocket__flight {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .sounding-rocket__craft {
    position: absolute;
    /* Nose-forward diagonal; starts off left, exits upper-right */
    left: -8%;
    bottom: 18%;
    width: clamp(2.75rem, 5.5vw, 4.25rem);
    height: auto;
    opacity: 0;
    transform-origin: center center;
    /* Rotate so the rocket flies roughly left→right, slightly climbing */
    transform: rotate(58deg) translate3d(0, 0, 0);
    /* Linear so the craft never eases to a stop mid-path or between loops */
    animation: sounding-rocket-cross 22s linear infinite;
    filter: drop-shadow(0 0 10px color-mix(in oklab, var(--color-solar) 28%, transparent));
  }

  .sounding-rocket__plume {
    animation: sounding-rocket-plume 0.6s ease-in-out infinite alternate;
    transform-origin: center top;
  }

  /* Position travels the full 0→100% range with no hold; fade only at edges */
  @keyframes sounding-rocket-cross {
    0% {
      opacity: 0;
      left: -12%;
      bottom: 18%;
      transform: rotate(58deg) scale(0.94);
    }
    6% {
      opacity: 0.55;
    }
    92% {
      opacity: 0.5;
    }
    100% {
      opacity: 0;
      left: 112%;
      bottom: 88%;
      transform: rotate(52deg) scale(0.94);
    }
  }

  @keyframes sounding-rocket-plume {
    from {
      opacity: 0.6;
      transform: scaleY(0.88);
    }
    to {
      opacity: 1;
      transform: scaleY(1.1);
    }
  }

  @media (max-width: 639px) {
    .sounding-rocket__craft {
      width: clamp(2.25rem, 9vw, 3.25rem);
      opacity: 0;
      animation-duration: 18s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sounding-rocket__craft {
      animation: none;
      opacity: 0.4;
      left: 12%;
      bottom: 62%;
      transform: rotate(58deg);
      filter: none;
    }

    .sounding-rocket__plume {
      animation: none;
      opacity: 0.45;
    }
  }
</style>
