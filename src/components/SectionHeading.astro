---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
}

const { eyebrow, title, description } = Astro.props;
---

<div class="mb-8 max-w-3xl">
  <p class="mb-2 text-xs font-semibold tracking-[0.18em] text-solar uppercase">{eyebrow}</p>
  <h1 class="font-heading text-3xl font-semibold tracking-tight text-ink md:text-4xl">{title}</h1>
  {description && <p class="mt-3 text-base leading-relaxed text-muted md:text-lg">{description}</p>}
</div>
