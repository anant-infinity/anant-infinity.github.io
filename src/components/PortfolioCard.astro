---
interface Props {
  id?: string;
  title: string;
  role: string;
  program: string;
  years: string;
  summary: string;
  href?: string;
}

const { id, title, role, program, years, summary, href } = Astro.props;

const meta = [role, program].filter(Boolean).join(' · ');
const isExternal = Boolean(href?.startsWith('http'));
---

<article
  id={id}
  class:list={[
    'portfolio-card flex h-full flex-col gap-2 rounded-sm border border-border bg-surface/60 p-5 scroll-mt-24 transition hover:border-solar/50 hover:bg-surface',
    href && 'group',
  ]}
>
  <p class="text-[10px] font-semibold tracking-[0.14em] text-solar uppercase">{years}</p>
  {
    href ? (
      <h3 class="font-heading text-lg font-semibold text-ink transition group-hover:text-solar md:text-xl">
        <a
          href={href}
          class="outline-none focus-visible:text-solar"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {title}
        </a>
      </h3>
    ) : (
      <h3 class="font-heading text-lg font-semibold text-ink md:text-xl">{title}</h3>
    )
  }
  <p class="text-sm leading-relaxed text-muted/80">{meta}</p>
  <p class="mt-1 flex-1 text-sm leading-relaxed text-muted md:text-[0.95rem]">{summary}</p>
  {
    href && (
      <p class="mt-3">
        <a
          href={href}
          class="text-sm text-muted transition hover:text-solar"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          Learn more →
        </a>
      </p>
    )
  }
</article>
