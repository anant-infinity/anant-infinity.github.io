---
interface Props {
  id?: string;
  title: string;
  role: string;
  program: string;
  years: string;
  summary: string;
  href?: string;
  amount?: string;
}

const { id, title, role, program, years, summary, href, amount } = Astro.props;

const metaParts = [role, program, years].filter(Boolean);
const meta = metaParts.join(' · ');
const isExternal = Boolean(href?.startsWith('http'));
---

<article
  id={id}
  class:list={[
    'flex flex-col gap-3 border-t border-border py-8 first:border-t-0 first:pt-0 scroll-mt-24',
    href && 'group',
  ]}
>
  <div class="max-w-3xl">
    {
      href ? (
        <h3 class="font-heading text-lg font-semibold text-ink transition group-hover:text-solar md:text-xl">
          <a
            href={href}
            class="outline-none focus-visible:text-solar"
            {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {title}
          </a>
        </h3>
      ) : (
        <h3 class="font-heading text-lg font-semibold text-ink md:text-xl">{title}</h3>
      )
    }
    <p class="mt-2 text-sm leading-relaxed text-muted/80">{meta}</p>
    {amount && <p class="mt-1 text-sm text-muted/70">{amount}</p>}
    <p class="mt-3 text-sm leading-relaxed text-muted md:text-[0.95rem]">{summary}</p>
    {
      href && (
        <p class="mt-4">
          <a
            href={href}
            class="text-sm text-muted transition hover:text-solar"
            {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            Learn more →
          </a>
        </p>
      )
    }
  </div>
</article>
