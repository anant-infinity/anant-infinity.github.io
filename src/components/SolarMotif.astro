<figure class="fade-in fade-in-delay-2">
  <div class="relative aspect-square overflow-hidden rounded-sm border border-border bg-surface">
    <svg viewBox="0 0 480 480" class="h-full w-full" role="img" aria-label="Abstract solar and orbital motif">
      <defs>
        <radialGradient id="sun" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#F4C38A" />
          <stop offset="55%" stop-color="#D88952" stop-opacity="0.85" />
          <stop offset="100%" stop-color="#426B8C" stop-opacity="0.15" />
        </radialGradient>
      </defs>
      <rect width="480" height="480" fill="#F8FAFC" />
      <g stroke="#E2E8F0" stroke-width="1" fill="none">
        <circle cx="240" cy="240" r="70" />
        <circle cx="240" cy="240" r="120" />
        <circle cx="240" cy="240" r="170" />
        <ellipse cx="240" cy="240" rx="200" ry="92" transform="rotate(-18 240 240)" />
        <ellipse cx="240" cy="240" rx="210" ry="78" transform="rotate(32 240 240)" />
      </g>
      <circle cx="240" cy="240" r="38" fill="url(#sun)" />
      <circle cx="360" cy="188" r="5" fill="#426B8C" />
      <circle cx="148" cy="302" r="4" fill="#10243A" opacity="0.7" />
      <circle cx="310" cy="340" r="3" fill="#566879" />
      <g fill="#426B8C" opacity="0.35">
        <circle cx="72" cy="84" r="1.5" />
        <circle cx="410" cy="96" r="1.2" />
        <circle cx="420" cy="380" r="1.4" />
        <circle cx="90" cy="400" r="1.1" />
        <circle cx="250" cy="60" r="1.2" />
      </g>
    </svg>
  </div>
  <figcaption class="mt-3 text-sm text-muted">
    Abstract solar / orbital motif — replace with photography when ready.
  </figcaption>
</figure>
