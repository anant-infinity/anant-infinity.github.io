---
interface Props {
  title: string;
  role: string;
  program: string;
  summary: string;
  href: string;
}

const { title, role, program, summary, href } = Astro.props;
const meta = `${role} · ${program}`;
---

<a
  href={href}
  class="group flex flex-col border-t border-border pt-5 transition first:border-t-0 first:pt-0 md:border-t-0 md:border-l md:pt-0 md:pl-6 md:first:border-l-0 md:first:pl-0"
>
  <h3 class="font-heading text-lg font-semibold text-ink transition group-hover:text-solar">
    {title}
  </h3>
  <p class="mt-2 text-sm text-muted/80">{meta}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{summary}</p>
  <span class="mt-4 text-sm text-muted transition group-hover:text-solar">Learn more →</span>
</a>
