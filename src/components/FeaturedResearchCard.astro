---
interface Props {
  title: string;
  role: string;
  program: string;
  summary: string;
  href?: string;
}

const { title, role, program, summary, href } = Astro.props;
const meta = `${role} · ${program}`;
const isExternal = Boolean(href?.startsWith('http'));
---

<article
  class:list={[
    'flex flex-col border-t border-border pt-5 first:border-t-0 first:pt-0 md:border-t-0 md:border-l md:pt-0 md:pl-6 md:first:border-l-0 md:first:pl-0',
    href && 'group',
  ]}
>
  <h3 class="font-heading text-lg font-semibold text-ink md:text-lg">
    {
      href ? (
        <a
          href={href}
          class="transition outline-none group-hover:text-solar focus-visible:text-solar"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  <p class="mt-2 text-sm text-muted/80">{meta}</p>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{summary}</p>
  {
    href && (
      <p class="mt-4">
        <a
          href={href}
          class="text-sm text-muted transition hover:text-solar"
          {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          Learn more →
        </a>
      </p>
    )
  }
</article>
